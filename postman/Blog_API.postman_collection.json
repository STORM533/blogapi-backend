{
  "info": {
    "name": "Blog API",
    "description": "Blog API requests for authentication, authorization, posts, and comments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "authorToken",
      "value": ""
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    },
    {
      "key": "authorCommentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"YOUR_USER_USERNAME\",\n  \"email\": \"youruser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Login USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"YOUR_USER_USERNAME\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('userToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login AUTHOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"YOUR_AUTHOR_USERNAME\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('authorToken', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "Get Post",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        },
        {
          "name": "Create Post as AUTHOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Postman Test Post\",\"content\":\"Created from Postman.\"}"
            },
            "url": "{{baseUrl}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set('postId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Post as USER - expect 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Forbidden\",\"content\":\"USER cannot create posts.\"}"
            },
            "url": "{{baseUrl}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('USER is forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Post without token - expect 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Unauthorized\",\"content\":\"No token.\"}"
            },
            "url": "{{baseUrl}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated is rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Updated Postman Post\",\"content\":\"Updated content.\"}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "Create Comment as USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"A Postman test comment.\"}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set('commentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Comment without token - expect 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Should be rejected.\"}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated is rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Own Comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Updated by the owner.\"}"
            },
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Create Comment for AUTHOR Deletion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Comment for AUTHOR deletion test.\"}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('authorCommentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Any Comment as AUTHOR",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "url": "{{baseUrl}}/comments/{{authorCommentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('AUTHOR can delete any comment', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Own Comment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('USER can delete their own comment', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Post as AUTHOR",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('AUTHOR can delete the post', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
